# ------------------------------------------------------------
# compose-vps-deploy-framework - project contract (v0.1 MVP)
# Copy to config/project.env and adjust values.
# ------------------------------------------------------------

# SSH target (used by GitHub adapter)
SSH_HOST=example-vps.company.com
SSH_USER=deploy
SSH_PORT=22
DEPLOY_PATH=/opt/compose-vps-deploy-framework

# Docker Compose runtime
COMPOSE_FILE=/opt/compose-vps-deploy-framework/examples/minimal-compose/docker-compose.prod.yml
COMPOSE_PROJECT_NAME=sample-prod
# Optional comma-separated list of env files consumed by docker compose
COMPOSE_ENV_FILES=

# Deploy env materialization
DEPLOY_ENV_FILE=/opt/compose-vps-deploy-framework/env/.env.deploy
APP_ENV_FILE=/opt/compose-vps-deploy-framework/env/.env.app
# Optional payloads injected by CI (base64 encoded)
APP_ENV_B64=
EXTRA_ENV_B64=
EXTRA_ENV_FILE=/opt/compose-vps-deploy-framework/env/.env.extra

# Optional cloudflared token materialization
CLOUDFLARED_ENV_FILE=/opt/compose-vps-deploy-framework/env/.env.cloudflared
TUNNEL_TOKEN=

# Registry auth
REGISTRY_HOST=ghcr.io
REGISTRY_USERNAME=replace_me
REGISTRY_PASSWORD=replace_me

# Image coordinates + tags
API_IMAGE=ghcr.io/acme/sample-api
MIGRATOR_IMAGE=ghcr.io/acme/sample-migrator
FRONT_IMAGE=ghcr.io/acme/sample-front
API_TAG=latest
MIGRATOR_TAG=latest
FRONT_TAG=latest
# Optional additional images to pre-pull
EXTRA_PULL_IMAGES=public.ecr.aws/docker/library/postgres:16-alpine,public.ecr.aws/docker/library/nginx:1.25-alpine

# Runtime services
MIGRATOR_SERVICE=migrator
HEALTH_SERVICES=postgres,api,front,nginx
HEALTH_TIMEOUT_SECONDS=180
HEALTH_POLL_SECONDS=5

# Cleanup behavior
CLEANUP_ENABLED=true
