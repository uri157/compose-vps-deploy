DEPLOY_PATH=/opt/myapp-infra

COMPOSE_FILE=/opt/myapp-infra/examples/minimal-compose/docker-compose.prod.yml
# Single-host example:
# COMPOSE_EXTRA_FILES=/opt/myapp-infra/examples/minimal-compose/docker-compose.single-host.yml
# Multi-project + cloudflared example:
# COMPOSE_EXTRA_FILES=/opt/myapp-infra/examples/minimal-compose/docker-compose.edge-cloudflared.yml
COMPOSE_EXTRA_FILES=
COMPOSE_PROJECT_NAME=myapp-prod
COMPOSE_ENV_FILES=

DEPLOY_ENV_FILE=/opt/myapp-infra/env/.env.deploy
DB_ENV_FILE=/opt/myapp-infra/examples/minimal-compose/env/.env.db
API_ENV_FILE=/opt/myapp-infra/examples/minimal-compose/env/.env.api
FRONT_ENV_FILE=/opt/myapp-infra/examples/minimal-compose/env/.env.front

REGISTRY_HOST=ghcr.io
REGISTRY_USERNAME=replace_me
REGISTRY_PASSWORD=replace_me

API_IMAGE=public.ecr.aws/docker/library/nginx
MIGRATOR_IMAGE=public.ecr.aws/docker/library/busybox
FRONT_IMAGE=public.ecr.aws/docker/library/nginx
API_TAG=1.25-alpine
MIGRATOR_TAG=1.36
FRONT_TAG=1.25-alpine

MIGRATION_MODE=service
MIGRATOR_SERVICE=migrator
MIGRATION_COMMAND=

HEALTH_SERVICES=postgres,api,front,nginx
HEALTH_TIMEOUT_SECONDS=180
HEALTH_POLL_SECONDS=5

EXTRA_PULL_IMAGES=public.ecr.aws/docker/library/postgres:16-alpine
PRE_DEPLOY_HOOK=
POST_DEPLOY_HOOK=
CLEANUP_ENABLED=true
